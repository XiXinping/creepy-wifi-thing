---
// A text slot: optional heading + paragraph (+ children). Copy is written by the authors; lorem until then.
interface Props {
  title?: string;
  body: string;
  class?: string;
  [attr: `data-${string}`]: string | number;
}
const { title, body, class: cls, ...attrs } = Astro.props;
// [text](url) in the copy becomes a link: split gives text, label, url, text, label, url, ...
const parts = body.split(/\[([^\]]+)\]\(([^)\s]+)\)/);
---

<div class:list={["slot", cls]} {...attrs}>
  {title && <h2>{title}</h2>}
  <p>{parts.map((s, i) => (i % 3 === 1 ? <a href={parts[i + 1]}>{s}</a> : i % 3 === 0 && s))}</p>
  <slot />
</div>
