---
import Slot from "../Slot.astro";
import { frames } from "../../lib/renders";
---

<section
  class="pin hero"
  id="hero"
  data-frames={JSON.stringify(frames("hero"))}
>
  <div class="stage">
    <h1>CSIspy</h1>
    <canvas aria-hidden="true"></canvas>
    <Slot class="lede" body="By Matty, Mori, and Owen" />
  </div>
</section>

<style>
  .hero {
    height: 250vh;
  }

  h1 {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 0 var(--gutter);
    font-size: clamp(4.5rem, 19vw, 21rem);
    /* difference over the render: warm over the blue floor, light over the dark PCB, dark over the white
       highlights; the heavier weight keeps the strokes thick enough to survive the colour changes */
    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.02em;
    color: var(--bloom);
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* the title already reads over the render; no dark pool behind the byline */
  .hero :global(.lede) {
    text-shadow: none;
    background: none;
  }
  .hero :global(.lede)::before {
    content: none;
  }

  @media (orientation: portrait) {
    h1 {
      align-content: start;
      padding-top: 12svh;
      font-size: 27vw;
    }
  }

  @media (orientation: landscape) {
    .hero :global(.lede) {
      bottom: 9vh;
    }
  }
</style>

<script>
  import { token } from "../../lib/color";
  import { heroFit } from "../../lib/room";
  import { onFrame, progress, seg } from "../../lib/scroll";
  import { sequence } from "../../lib/sequence";
  import { sizeCanvas } from "../../lib/stage";

  const root = document.getElementById("hero")!;
  const canvas = root.querySelector("canvas")!;
  const ctx = canvas.getContext("2d")!;
  const fading = root.querySelectorAll<HTMLElement>("h1, .slot");
  const seq = sequence("hero", JSON.parse(root.dataset.frames!));
  const deep = token("deep");
  seq.load();

  onFrame(() => {
    const { p, visible } = progress(root);
    if (!visible) return;
    const { w, h, dpr } = sizeCanvas(canvas);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    seq.draw(ctx, p, heroFit(w, h), deep);
    // type leaves before the hand-off to the rise sequence, which starts on this exact frame
    const o = String(1 - seg(p, 0.7, 0.95));
    fading.forEach((el) => (el.style.opacity = o));
  });
</script>
