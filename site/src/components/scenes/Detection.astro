---
import Slot from "../Slot.astro";
---

<section class="pin detection" id="detection">
  <div class="stage">
    <canvas aria-hidden="true"></canvas>
    <Slot
      class="side"
      title="Sensing motion in real-time"
      body="We can assign a score to how likely it is that an object is moving based on factors like the change in amplitude. Past an empirical threshold, we consider the evidence strong enough to assert that something is moving. Our work lies in devising an accurate metric and sensible decision boundary, whether through rolling variance or black-box neural nets."
    />
  </div>
</section>

<style>
  .detection {
    height: 250vh;
  }
</style>

<script>
  import { css, token } from "../../lib/color";
  import { loadCsi, score, threshold } from "../../lib/data";
  import { onFrame, progress, seg } from "../../lib/scroll";
  import { label, panelRect, sizeCanvas } from "../../lib/stage";

  const root = document.getElementById("detection")!;
  const canvas = root.querySelector("canvas")!;
  const slot = root.querySelector<HTMLElement>(".slot")!;
  const ctx = canvas.getContext("2d")!;
  const [wash, bloom, enig] = ["wash", "bloom", "enig"].map(token);

  let series: number[] = [];
  let cuts: number[] = [];
  let thr = 0;
  loadCsi().then(({ recs }) => {
    const WARMUP = 10; // frames while prep_csi's 0.5 s rolling-variance window is still filling
    const [empty, still, motion] = ["empty", "still", "motion"].map((n) =>
      score(recs[n].var).slice(WARMUP),
    );
    series = [...empty, ...still, ...motion];
    cuts = [empty.length, empty.length + still.length];
    thr = threshold(empty, still);
  });

  let last = "";
  onFrame(() => {
    const { p, visible } = progress(root);
    if (!visible || !series.length) return;
    const { w, h, dpr } = sizeCanvas(canvas);
    const key = `${p}|${canvas.width}|${canvas.height}`;
    if (key === last) return;
    last = key;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);

    const r = panelRect(w, h, slot.getBoundingClientRect().top - canvas.getBoundingClientRect().top - 48); // labels below the panel clear the copy
    const lo = Math.min(...series);
    const hi = Math.max(...series);
    const X = (i: number) => r.x + (i / (series.length - 1)) * r.w;
    const Y = (v: number) => r.y + r.h * (1 - (v - lo) / (hi - lo));
    const n = Math.round(seg(p, 0.05, 0.9) * (series.length - 1));
    const line = () => {
      ctx.beginPath();
      for (let i = 0; i <= n; i++) ctx.lineTo(X(i), Y(series[i]));
    };

    ctx.lineWidth = 1;
    ctx.strokeStyle = css(wash, 0.25);
    for (const c of cuts) {
      ctx.beginPath();
      ctx.moveTo(X(c), r.y);
      ctx.lineTo(X(c), r.y + r.h);
      ctx.stroke();
    }

    // who was in the room: nobody, then someone standing still, then someone moving
    [0, ...cuts].forEach((c0, i) => {
      const c1 = [...cuts, series.length - 1][i];
      ctx.fillStyle = i ? css(enig, 0.9) : css(wash, 0.6);
      ctx.fillRect(X(c0) + 2, r.y + r.h + 14, X(c1) - X(c0) - 4, i ? 3 : 1);
      label(
        ctx,
        ["empty", "standing still", "moving"][i],
        (X(c0) + X(c1)) / 2,
        r.y + r.h + 32,
        i ? css(enig, 0.9) : css(bloom, 0.75),
        "center",
      );
    });

    // faint exposure under the drawn line
    line();
    ctx.lineTo(X(n), r.y + r.h);
    ctx.lineTo(X(0), r.y + r.h);
    ctx.fillStyle = css(wash, 0.12);
    ctx.fill();

    ctx.save();
    ctx.beginPath();
    ctx.rect(r.x, r.y - 4, r.w, Y(thr) - r.y + 4);
    ctx.clip();
    line();
    ctx.lineTo(X(n), Y(thr));
    ctx.lineTo(X(0), Y(thr));
    ctx.fillStyle = css(enig, 0.85);
    ctx.fill();
    ctx.restore();

    ctx.setLineDash([6, 6]);
    ctx.strokeStyle = css(wash, 0.9);
    ctx.beginPath();
    ctx.moveTo(r.x, Y(thr));
    ctx.lineTo(r.x + r.w, Y(thr));
    ctx.stroke();
    ctx.setLineDash([]);
    label(ctx, "threshold", r.x + 4, Y(thr) - 10, css(bloom, 0.75));
    label(
      ctx,
      "motion score",
      r.x - 12,
      r.y + r.h / 2,
      css(bloom, 0.75),
      "center",
      true,
    );

    ctx.lineWidth = 1.25;
    ctx.strokeStyle = css(bloom);
    line();
    ctx.stroke();

    // the line itself turns gold above the threshold
    ctx.save();
    ctx.beginPath();
    ctx.rect(r.x, r.y - 4, r.w, Y(thr) - r.y + 4);
    ctx.clip();
    ctx.lineWidth = 2;
    ctx.strokeStyle = css(enig);
    line();
    ctx.stroke();
    ctx.restore();
  });
</script>
