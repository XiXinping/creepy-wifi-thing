---
import Slot from "../Slot.astro";
import { frames } from "../../lib/renders";

// the last hero frame that exists, at whichever sizes exist
const f = frames("hero");
const last = f ? Math.max(...(f.lg.length ? f.lg : f.sm)) : -1;
const url = (size: string) => `${import.meta.env.BASE_URL}renders/hero/${size}/${String(last).padStart(4, "0")}.webp`;
const srcset = (["sm", "lg"] as const)
  .filter((size) => f?.[size].includes(last))
  .map((size) => `${url(size)} ${size === "sm" ? 960 : 1920}w`)
  .join(", ");
---

<section class="outro">
  {srcset && <img srcset={srcset} sizes="100vw" alt="" loading="lazy" decoding="async" />}
  <Slot
    class="end"
    title="Duis aute irure"
    body="Cras mattis consectetur purus sit amet fermentum. Aenean eu leo quam, pellentesque ornare sem lacinia quam venenatis vestibulum. Fusce dapibus, tellus ac cursus commodo, tortor mauris condimentum nibh, ut fermentum massa justo sit amet risus."
  >
    <a class="gh" href="https://github.com/XiXinping/creepy-wifi-thing" aria-label="Source code on GitHub">
      <svg viewBox="0 0 16 16" width="36" height="36" aria-hidden="true" fill="currentColor">
        <path
          d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
        ></path>
      </svg>
    </a>
  </Slot>
</section>

<style>
  .outro {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .gh {
    color: var(--bloom);
    justify-self: start;
    display: inline-flex;
    padding: 6px;
    margin-left: -6px;
    border-radius: 50%;
  }

  .gh:hover {
    color: var(--wash);
  }

  @media (orientation: landscape) {
    .outro :global(.end) {
      bottom: 14vh;
    }
  }
</style>
